{
  "name": "agentdoor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "docker:up": "docker compose -f infra/compose/compose.yaml up -d --build",
    "docker:down": "docker compose -f infra/compose/compose.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "turbo": "2.10.8",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

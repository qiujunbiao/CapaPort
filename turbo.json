{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AGENTDOOR_ACCEPTANCE_STAMP",
    "AGENTDOOR_API_URL",
    "AGENTDOOR_MAILPIT_URL",
    "AGENTDOOR_REGISTRY",
    "npm_package_version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}

# Images are built as <version>-<12-character-git-revision>; never use latest.
AGENTDOOR_REGISTRY=registry.example.com/agentdoor
AGENTDOOR_IMAGE_TAG=0.1.0-0123456789ab
AGENTDOOR_SECRETS_DIR=/etc/agentdoor/secrets
AGENTDOOR_BIND_ADDRESS=127.0.0.1
AGENTDOOR_API_PORT=3210

REDIS_URL=rediss://redis.example.com:6379
S3_ENDPOINT=https://s3.internal.example.com
S3_PUBLIC_ENDPOINT=https://downloads.example.com
S3_REGION=us-east-1
S3_BUCKET=agentdoor-production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=Agentdoor <no-reply@example.com>
SMS_PROVIDER_URL=https://sms.example.com/v1/messages
SMS_SENDER=Agentdoor
SMS_TIMEOUT_MS=5000

# Images are built as <version>-<12-character-git-revision>; never use latest.
CAPAPORT_REGISTRY=registry.example.com/capaport
CAPAPORT_IMAGE_TAG=0.1.0-0123456789ab
CAPAPORT_SECRETS_DIR=/etc/capaport/secrets
CAPAPORT_BIND_ADDRESS=127.0.0.1
CAPAPORT_API_PORT=3210
CORS_ORIGINS=https://capaport.example.com

REDIS_URL=rediss://redis.example.com:6379
S3_ENDPOINT=https://s3.internal.example.com
S3_PUBLIC_ENDPOINT=https://downloads.example.com
S3_REGION=us-east-1
S3_BUCKET=capaport-production
S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_KMS_KEY_ID=alias/capaport
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=CapaPort <no-reply@example.com>
SMS_PROVIDER_URL=https://sms.example.com/v1/messages
SMS_SENDER=CapaPort
SMS_TIMEOUT_MS=5000

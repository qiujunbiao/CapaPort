{
  "name": "@capaport/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "capaport": "dist/capaport.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsx scripts/build.ts",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @capaport/adapter-sdk build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capaport/adapter-claude-code": "workspace:*",
    "@capaport/adapter-codex": "workspace:*",
    "@capaport/adapter-cursor": "workspace:*",
    "@capaport/adapter-gemini-cli": "workspace:*",
    "@capaport/adapter-sdk": "workspace:*",
    "@capaport/capability-kit": "workspace:*",
    "@capaport/contracts": "workspace:*",
    "@capaport/sdk": "workspace:*",
    "@capaport/security-scan": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

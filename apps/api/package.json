{
  "name": "@capaport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @capaport/contracts build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "pretest": "pnpm --filter @capaport/contracts build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/s3-request-presigner": "3.1105.0",
    "@capaport/capability-kit": "workspace:*",
    "@capaport/contracts": "workspace:*",
    "@capaport/domain-types": "workspace:*",
    "@capaport/security-scan": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@google-cloud/recaptcha-enterprise": "7.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@node-rs/argon2": "2.0.2",
    "@zxcvbn-ts/core": "4.1.2",
    "@zxcvbn-ts/language-common": "4.1.3",
    "bullmq": "5.58.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "ioredis": "6.0.0",
    "jose": "6.1.3",
    "nodemailer": "7.0.11",
    "pg": "8.22.0",
    "recaptcha-password-check-helpers": "1.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/node": "26.1.2",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

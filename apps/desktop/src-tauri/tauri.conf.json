{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentdoor",
  "version": "0.1.0",
  "identifier": "com.agentdoor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": ["tauri-app"]
  },
  "app": {
    "windows": [
      {
        "title": "Agentdoor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3210 http://127.0.0.1:9000; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgQUZGMDFGNTY0MUEzNEZENgpSV1RXVDZOQlZoL3dyOTVCVDljczliT0pvWEY3Y3FjaUIySmRYSkZKUEcvaUVtbkZBU1hPYzgzOQ==",
      "endpoints": ["https://releases.agentdoor.com/desktop/{{target}}/{{arch}}/{{current_version}}"],
      "dangerousInsecureTransportProtocol": false
    }
  }
}
